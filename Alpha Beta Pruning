# Global logs
pruned = []
visited = []
optimal_path = []


def alphabeta(node, depth, alpha, beta, maximizingPlayer, path):
    global pruned, visited, optimal_path

    # If leaf: return its value
    if node.value is not None:
        visited.append((node.name, node.value))
        return node.value

    if maximizingPlayer:
        value = float('-inf')
        for child in node.children:
            new_path = path + [child.name]
            val = alphabeta(child, depth + 1, alpha, beta, False, new_path)

            if val > value:
                value = val
                if depth == 0:  # Save path at root
                    optimal_path = new_path

            alpha = max(alpha, value)

            if beta <= alpha:
                pruned.append(f"Pruned children of {node.name} after {child.name}")
                break

        return value

    else:
        value = float('inf')
        for child in node.children:
            new_path = path + [child.name]
            val = alphabeta(child, depth + 1, alpha, beta, True, new_path)

            if val < value:
                value = val

            beta = min(beta, value)

            if beta <= alpha:
                pruned.append(f"Pruned children of {node.name} after {child.name}")
                break

        return value


# ---- RUN SEARCH ----
result = alphabeta(A, 0, float('-inf'), float('inf'), True, ["A"])

